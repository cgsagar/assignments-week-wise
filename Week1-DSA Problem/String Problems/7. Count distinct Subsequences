//Approach 1 - Dynamic Programming Problem - Time complexity - O(n) and Space complexity is O(n)
function countDistinctSubsequences(str) {
    const n = str.length;

    const dp = new Array(n + 1).fill(0);
    dp[0] = 1; // empty subsequence

    const lastSeen = {};

    for (let i = 1; i <= n; i++) {
        dp[i] = 2 * dp[i - 1];

        const ch = str[i - 1];

        if (lastSeen[ch] !== undefined) {
            dp[i] -= dp[lastSeen[ch] - 1];
        }

        lastSeen[ch] = i;
    }

    return dp[n];
}

console.log(countDistinctSubsequences("gfg")); // 7
console.log(countDistinctSubsequences("ggg")); // 4
