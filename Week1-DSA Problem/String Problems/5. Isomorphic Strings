//Approach 2 - Brute Force approach - Time Complexity  : O(n2)  Space Complexity : O(1) - Hashing

function isIsomorphic(s1, s2) {
    if (s1.length !== s2.length) return false;

    for (let i = 0; i < s1.length; i++) {
        for (let j = 0; j < i; j++) {

            // Same character in s1 should map to same char in s2
            if (s1[i] === s1[j] && s2[i] !== s2[j]) {
                return false;
            }

            // Different characters in s1 cannot map to same char in s2
            if (s1[i] !== s1[j] && s2[i] === s2[j]) {
                return false;
            }
        }
    }

    return true;
}

console.log(isIsomorphic("aab", "xxy")); // true
