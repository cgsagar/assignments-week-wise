//The complexity is considered O(1) because:
//The values array always has 13 elements.
//The maximum number is fixed (3999).
//The maximum number of iterations is bounded.


Approach is time complexity is 0(1) and time complexity is 0(1)



function decimalToRoman(num) {

    const values = [
        1000, 900, 500, 400,
        100, 90, 50, 40,
        10, 9, 5, 4, 1
    ];

    const symbols = [
        "M", "CM", "D", "CD",
        "C", "XC", "L", "XL",
        "X", "IX", "V", "IV", "I"
    ];

    let result = "";

    for (let i = 0; i < values.length; i++) {

        while (num >= values[i]) {
            result += symbols[i]; 
            num -= values[i];  
        }
    }

    return result;
}

