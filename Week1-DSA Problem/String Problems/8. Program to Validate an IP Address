
//IPV4 Address Approach - Time complexity is O(n) and O(1)

function isValidIPv4(ip) {
    const parts = ip.split(".");

    // Must have exactly 4 parts
    if (parts.length !== 4) {
        return false;
    }

    for (let part of parts) {

        // Empty part
        if (part.length === 0) {
            return false;
        }

        // Check if all characters are digits
        for (let ch of part) {
            if (ch < '0' || ch > '9') {
                return false;
            }
        }

        // No leading zeros
        if (part.length > 1 && part[0] === '0') {
            return false;
        }

        const num = Number(part);

        // Range check
        if (num < 0 || num > 255) {
            return false;
        }
    }

    return true;
}

// Test Cases
console.log(isValidIPv4("192.168.1.1"));      // true
console.log(isValidIPv4("255.255.255.255"));  // true
console.log(isValidIPv4("0.0.0.0"));          // true
console.log(isValidIPv4("256.10.20.30"));     // false
console.log(isValidIPv4("192.168.01.1"));     // false
console.log(isValidIPv4("1.1.1"));            // false



//IPV6 Address Approach - Time complexity is O(n) and O(1)
function isValidIPv6(ip) {
    const parts = ip.split(":");

    if (parts.length !== 8) {
        return false;
    }

    for (let part of parts) {

        if (part.length === 0 || part.length > 4) {
            return false;
        }

        for (let ch of part) {
            const isDigit = ch >= '0' && ch <= '9';
            const isLower = ch >= 'a' && ch <= 'f';
            const isUpper = ch >= 'A' && ch <= 'F';

            if (!isDigit && !isLower && !isUpper) {
                return false;
            }
        }
    }

    return true;
}

console.log(isValidIPv6("2001:0db8:85a3:0000:0000:8a2e:0370:7334"));   
