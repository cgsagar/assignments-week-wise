//Approach 1 - Dynamic Programming Problem - Time complexity - O(n) and Space complexity is O(n)
function countDistinctSubsequences(str) {
    const n = str.length;

    const dp = new Array(n + 1).fill(0);
    dp[0] = 1; // empty subsequence

    const lastSeen = {};

    for (let i = 1; i <= n; i++) {
        dp[i] = 2 * dp[i - 1];

        const ch = str[i - 1];

        if (lastSeen[ch] !== undefined) {
            dp[i] -= dp[lastSeen[ch] - 1];
        }

        lastSeen[ch] = i;
    }

    return dp[n];
}

console.log(countDistinctSubsequences("gfg")); // 7
console.log(countDistinctSubsequences("ggg")); // 4


//Approach 2 - Brute force - Time Complexity  : O(2^n) and Space Complexity : O(2^n)


function countDistinctSubsequences(str) {
    const set = new Set();

    function generate(index, current) {

        // Base case
        if (index === str.length) {
            set.add(current);
            return;
        }

        // Take current character
        generate(index + 1, current + str[index]);

        // Skip current character
        generate(index + 1, current);
    }

    generate(0, "");

    return set.size;
}

console.log(countDistinctSubsequences("gfg")); // 7
console.log(countDistinctSubsequences("ggg")); // 4
